# Environment Variables for 9ashy Marketplace

# Database
DATABASE_URL="file:./dev.db"
# For PostgreSQL (production): DATABASE_URL="postgresql://user:password@localhost:5432/9ashy"

# JWT Secret (generate a strong random string)
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: Email (for password reset - logs to console if not set)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"
# EMAIL_FROM="noreply@9ashy.com"
